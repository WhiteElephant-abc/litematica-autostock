{
	"schemaVersion": 1,
	"id": "litematica-autostock",
	"version": "${version}",
	"name": "Litematica AutoStock",
	"description": "Client-side Litematica addon that automatically gathers missing materials from nearby containers using Baritone.",
	"authors": [
		"WhiteElephant-abc"
	],
	"contact": {
		"homepage": "https://github.com/WhiteElephant-abc/litematica-autostock",
		"sources": "https://github.com/WhiteElephant-abc/litematica-autostock",
		"issues": "https://github.com/WhiteElephant-abc/litematica-autostock/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/litematica-autostock/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "io.github.whiteelephantabc.autostock.client.LitematicaAutostockClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		{
			"config": "litematica-autostock.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": ">=26.3 <26.4",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"malilib": ">=0.30.2- <0.31.0-",
		"litematica": "*",
		"baritone": "*"
	},
	"suggests": {
		"minihud": "*"
	}
}
